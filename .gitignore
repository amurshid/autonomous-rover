# Dataset — 13,875 images, transferred manually between machines
vpr_data/

# Planning docs — transferred manually
rover_planning/

# Cached descriptors. Regenerated by extract_cached() in ~10 min; the cache key
# includes absolute image paths, so these are machine-specific anyway and would
# always miss after a clone.
vpr/out/features/

# Fine-tuned backbone weights (~88 MB each, one per --blocks setting).
# Regenerated by 10_finetune.py; 11_finetune_eval.py reloads the _blocks*
# copies, so keep them on disk even though they are not committed.
# The small projection heads in out/*.pt ARE committed — 09 and 10 load them
# for their comparison tables and they are only 2.3 MB each.
vpr/out/finetuned_backbone*.pt

# TorchScript export for the Pi (88 MB): architecture + weights in one file, so
# deployment needs neither torch.hub nor network access. Rebuilt from the
# checkpoint above.
vpr/out/vpr_encoder_traced.pt

# Deployment bundle for the Pi (109 MB). Rebuilt by vpr/deploy/export.py.
vpr/out/bundle/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/
env/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Personal logs
vpr_ml_handoff.md
deploy_handoff.md

# Shadow logs
vpr_relocalise_log.txt
vpr_relocalise_log2.txt
vpr_relocalise_log3.txt

# Machine-local: records that this machine passed the bundle self-test.
# Fingerprinted on the model, torch, numpy and vpr_relocalise.py, so it
# re-verifies by itself whenever any of those change.
.self_test_ok
