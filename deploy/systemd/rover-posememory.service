[Unit]
Description=Remember where the rover was, for the next start
# Cartographer is the pose source, and it now runs in both modes, so this
# does too -- a teleop drive updates the memory instead of invalidating it.
# Deliberately NOT Nav2: map_server lives inside Nav2, so a Requires= on it
# would start the planner during remote control, which is the one thing the
# Conflicts= pair exists to prevent. The map is read off disk instead.
# The seed, not Cartographer directly -- it pulls Cartographer in behind it.
# Depending on Cartographer alone let this start beside an unseeded one, which
# publishes the map origin from the moment it boots: recording that overwrote
# a good memory with (0, 0), and the free-floor check waved it through because
# the origin happens to sit on open floor.
After=rover-seedpose.service
Requires=rover-seedpose.service

# WantedBy only starts; PartOf is what propagates a stop. Stopping is when the
# final pose gets written, so this matters more here than elsewhere.
PartOf=rover-common.target rover-cartographer.service

[Service]
Type=simple
User=amurshid
WorkingDirectory=/home/amurshid
# /var/lib/rover, owned by this unit's user and kept across reboots. Not
# RuntimeDirectory: the whole point is surviving a power cut.
StateDirectory=rover
StateDirectoryMode=0755
# /run/rover is normally the bridge's, and without it the status file cannot
# be written -- which is how it failed the first time, with the bridge down.
# Preserve=yes so stopping this does not delete the bridge's telemetry.json
# out from under a bridge that is still running.
RuntimeDirectory=rover
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# print() to a pipe is block-buffered, so under systemd the log
# arrives in 4KB chunks or not until exit. These scripts say what
# they are doing through print(); unbuffered is what makes
# journalctl -f usable.
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && \
    source /home/amurshid/ros2_ws/install/setup.bash && \
    exec python3 /home/amurshid/rover_pose_memory.py'
# SIGTERM triggers one last sample before exit, so a clean stop records where
# it actually finished. Give that room rather than killing mid-write.
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

[Install]
WantedBy=rover-common.target
