[Unit]
Description=Cartographer pure localization against house.pbstream
# Ordering only -- systemd cannot know when the lidar is producing scans.
# Cartographer tolerates a late /scan, so this is safe here.
# The bridge is a hard dependency now, not just the lidar: with
# use_imu_data on, Cartographer blocks waiting for /imu/data before it will
# process a scan, and the bridge is what publishes it. No bridge, no
# localisation at all -- which is worse than the drift the IMU was added to
# cure, so make the ordering explicit rather than hoping.
After=rover-lidar.service rover-bridge.service
Requires=rover-lidar.service rover-bridge.service

# WantedBy only starts; PartOf is what makes "systemctl stop
# rover.target" stop this too.
PartOf=rover.target

[Service]
Type=simple
User=amurshid
WorkingDirectory=/home/amurshid
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && \
    source /home/amurshid/ros2_ws/install/setup.bash && \
    exec ros2 launch /home/amurshid/cartographer_localization.launch.py'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=rover.target
