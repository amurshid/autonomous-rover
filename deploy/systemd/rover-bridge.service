[Unit]
Description=Wave Rover ESP32 serial bridge (/cmd_vel -> motors)
After=network-online.target
Wants=network-online.target

# WantedBy only starts; PartOf is what makes "systemctl stop
# rover-common.target" stop this too. It is in the shared
# target because both modes need it: a mode switch must not
# cycle the motors or make the camera settle again.
PartOf=rover-common.target

[Service]
Type=simple
User=amurshid
WorkingDirectory=/home/amurshid
# print() to a pipe is block-buffered, so under systemd the log
# arrives in 4KB chunks or not until exit. These scripts say what
# they are doing through print(); unbuffered is what makes
# journalctl -f usable.
Environment=PYTHONUNBUFFERED=1
# /run/rover, owned by this unit's user and removed when it stops. The bridge
# leaves the battery voltage there because it owns the serial port and the
# mode page has no ROS to receive a topic on. Removal on stop is deliberate:
# a stale file would show the last voltage seen as though it were current.
RuntimeDirectory=rover
RuntimeDirectoryMode=0755
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && \
    source /home/amurshid/ros2_ws/install/setup.bash && \
    exec python3 /home/amurshid/wave_rover_bridge.py'
Restart=always
RestartSec=3

[Install]
WantedBy=rover-common.target
