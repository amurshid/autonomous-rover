# Install as /etc/sudoers.d/rover-mode  (mode 0440, owned by root)
#   sudo install -m 0440 -o root -g root rover-mode.sudoers /etc/sudoers.d/rover-mode
#
# The switcher page runs as amurshid and needs to start targets, and to start
# and stop rover-ai for the AI toggle. Reading unit state needs no privilege at
# all, so it is not listed. This grants exactly these four commands and nothing
# else -- not blanket sudo -- so a page reachable from the home network cannot
# do more than change which mode the rover is in and whether it is listening.
#
# rover-ai is the only unit that can be stopped from here, and stopping it is
# the harmless direction: the rover stops talking. Nothing here can stop the
# motors, Nav2, or the page itself.
amurshid ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block rover.target, \
                              /usr/bin/systemctl start --no-block rover-teleop.target, \
                              /usr/bin/systemctl start --no-block rover-ai.service, \
                              /usr/bin/systemctl stop --no-block rover-ai.service
