[Unit]
Description=Bridge /initialpose -> Cartographer trajectory restart
After=rover-cartographer.service
Requires=rover-cartographer.service

# WantedBy only starts; PartOf is what makes "systemctl stop
# rover.target" stop this too. A Cartographer restart also brings
# this down and back, because Cartographer returns on a default
# pose and everything downstream is then working from a stale one.
PartOf=rover.target rover-cartographer.service

[Service]
Type=simple
User=amurshid
WorkingDirectory=/home/amurshid
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && \
    source /home/amurshid/ros2_ws/install/setup.bash && \
    exec python3 /home/amurshid/set_initial_pose.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=rover.target
