[Unit]
Description=Mode switcher web page
# Belongs to neither mode and outlives both: if this goes down there is no way
# to switch back without SSH, which is exactly what it exists to avoid.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amurshid
WorkingDirectory=/home/amurshid
# Port 80 so the URL is just http://ahnaf-pi.local with nothing to remember.
# Binding below 1024 needs the capability; the process itself stays unprivileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=ROVER_MODE_PORT=80
Environment=ROVER_TELEOP_PORT=8080
# print() to a pipe is block-buffered, so under systemd the log
# arrives in 4KB chunks or not until exit. These scripts say what
# they are doing through print(); unbuffered is what makes
# journalctl -f usable.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/amurshid/rover_mode_web.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
