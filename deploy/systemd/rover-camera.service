[Unit]
Description=Pi camera (/camera/image_raw)
After=network-online.target
Wants=network-online.target

# Remote control only. It used to sit in the shared target because both
# modes needed it, but the autonomous consumer was the camera relocaliser and
# that is out of the deployment -- nothing in autonomous reads
# /camera/image_raw any more, so it was encoding frames for nobody at ~28% of
# a core on a Pi that throttles at 80 C. The cost of moving it is the
# auto-exposure settling again on each switch into remote control, which is
# paid once per switch instead of continuously.
#
# Starting rover-relocalise or running vpr_logger.py by hand still works: that
# unit has Requires=rover-camera.service and pulls this up wherever it lives.
#
# WantedBy only starts; PartOf is what makes "systemctl stop
# rover-teleop.target" stop this too.
PartOf=rover-teleop.target

[Service]
Type=simple
User=amurshid
WorkingDirectory=/home/amurshid
# format:=RGB888 is correct despite the topic reporting bgr8 -- libcamera's
# RGB888 is byte-order BGR in memory, which is what vpr_relocalise.py flips.
# The database was recorded through this exact pipeline. Do not "fix" it.
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && \
    source /home/amurshid/ros2_ws/install/setup.bash && \
    exec ros2 run camera_ros camera_node --ros-args \
        -p camera:=0 -p width:=320 -p height:=240 -p format:=RGB888'
Restart=always
RestartSec=3

[Install]
WantedBy=rover-teleop.target
